        {
          "id": "q3",
          "type": "short",
          "objective": "O4",
          "key": "A fixed workflow, because the steps and their order are known in advance and the same every time, so code can run them directly without the model deciding what to do next.",
          "answers": {
            "claude-sonnet-5-5": "A fixed workflow, because the steps are always the same and known in advance, so an agent's dynamic decision-making adds cost and unpredictability without benefit",
            "claude-haiku-5-5": "Workflow, because the steps are always the same and known in advance, so a model deciding the order adds cost without benefit"
          },
          "match": {
